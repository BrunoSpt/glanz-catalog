---js
{
  layout: "layouts/base.njk",
  permalink: "index.html",
  headerLink: "instagram",
  eleventyComputed: {
    title: (data) => data.site.title,
    description: (data) => data.site.description,
  },
}
---
{%- from "partials/product-card.njk" import productCard %}
{%- from "partials/icons.njk" import icon %}
  {% include "partials/category-circles.njk" %}

  {#- Pieces are unique and the collection is replaced every 2 months #}
  {#- js/collection.js replaces the generic note with the current cycle ("coleção de setembro e outubro…") #}
  <p class="collection-note" data-collection data-prefix="Peças únicas"
    data-first-cycle="{{ site.collection.firstCycle }}" data-months="{{ site.collection.months }}">
    {{ icon("gem") }}
    <span data-collection-text>{{ site.collection.note }}</span>
  </p>

  <section class="carousel-hero" aria-label="Destaques do catálogo">
    <div class="track" id="heroTrack">
      {%- for item in highlights %}
      {%- if item.comingSoon %}
      <div class="slide placeholder"><img src="/assets/brand/sunburst.png" width="160" height="165" alt=""><span>{{ item.comingSoon }}</span></div>
      {%- else %}
      <div class="slide"><img src="/{{ item.image }}" width="{{ item.width }}" height="{{ item.height }}" alt="{{ item.alt }}"><span class="caption">{{ item.caption }}</span></div>
      {%- endif %}
      {%- endfor %}
    </div>
    <div class="carousel-dots" id="heroDots"></div>
  </section>

  <section class="container section-tight" aria-label="Garantias">
    {% include "partials/guarantees.njk" %}
  </section>

  {%- set newArrivals = products | available | flagged("isNew") %}
  {%- if newArrivals | length %}
  <section class="container home-section" aria-labelledby="novidades">
    <h2 class="section-title serif" id="novidades">Novidades</h2>
    <div class="product-grid">
      {%- for product in newArrivals %}
      {{ productCard(product, site.name) }}
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  <section class="container home-section how-to-buy" id="como-comprar" aria-labelledby="como-comprar-title">
    <h2 class="section-title serif" id="como-comprar-title">Como comprar</h2>
    <ol class="steps">
      {%- for step in howToBuy %}
      <li class="step">
        <span class="step-number serif">{{ loop.index }}</span>
        <div>
          <h3>{{ step.title }}</h3>
          <p>{{ step.text }}</p>
        </div>
      </li>
      {%- endfor %}
    </ol>
    <div class="policies">
      <details class="policy">
        <summary>Parcelamento</summary>
        <ul>
          {%- for rule in storePolicies.installments %}
          <li>Compras acima de {{ rule.above | brl }}: em até <strong>{{ rule.count }}x sem juros</strong></li>
          {%- endfor %}
        </ul>
      </details>
      <details class="policy">
        <summary>Entrega</summary>
        <ul>
          {%- for line in storePolicies.delivery %}
          <li>{{ line }}</li>
          {%- endfor %}
        </ul>
      </details>
      <details class="policy">
        <summary>Garantia</summary>
        <p><strong>{{ storePolicies.warranty.summary }}</strong></p>
        <p class="policy-label">O que a garantia cobre</p>
        <ul>
          {%- for item in storePolicies.warranty.covers %}<li>{{ item }}</li>{% endfor %}
        </ul>
        <p class="policy-label">O que a garantia não cobre</p>
        <ul>
          {%- for item in storePolicies.warranty.doesNotCover %}<li>{{ item }}</li>{% endfor %}
        </ul>
        <p class="policy-label">Como solicitar</p>
        <p>{{ storePolicies.warranty.howToClaim }}</p>
      </details>
    </div>

    <div class="how-to-buy-actions">
      <button class="btn btn-secondary" type="button" data-list-open>{{ icon("heart") }} Ver minha lista</button>
      <a class="btn btn-primary" href="{{ '' | directLink }}" target="_blank" rel="noopener">{{ icon("instagram") }} Falar no Direct</a>
    </div>
  </section>

  <p class="tagline-line serif">"{{ site.tagline }}"</p>
