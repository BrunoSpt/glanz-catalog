---js
{
  layout: "layouts/base.njk",
  permalink: "index.html",
  eleventyComputed: {
    title: (data) => data.site.title,
    description: (data) => data.site.description,
  },
}
---
{%- from "partials/icons.njk" import icon %}
{%- from "partials/product-card.njk" import productCard %}
  {#- The one bold moment of the page: the campaign photo and the current collection.
      js/collection.js swaps the generic note ("Peças únicas") for the current cycle
      ("Coleção de setembro e outubro"), worked out from today's date. #}
  <section class="hero">
    {#- hero.json: one photo, or several taking turns (js/hero-carousel.js); the headline stays put #}
    {%- set isCarousel = hero | length > 1 %}
    <div class="hero-photo"{% if isCarousel %} data-hero-carousel aria-roledescription="carrossel" aria-label="Fotos da coleção"{% endif %}>
      <div class="hero-track">
        {%- for photo in hero %}
        <div class="hero-slide"{% if isCarousel %} aria-roledescription="foto" aria-label="{{ loop.index }} de {{ hero | length }}"{% endif %}>
          <img src="/{{ photo.image }}" width="{{ photo.width }}" height="{{ photo.height }}" alt="{{ photo.alt }}"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
        </div>
        {%- endfor %}
      </div>
      {%- if isCarousel %}
      <div class="hero-dots">
        {%- for photo in hero %}
        <button type="button" aria-label="Ver foto {{ loop.index }} de {{ hero | length }}"{% if loop.first %} class="active" aria-current="true"{% endif %}></button>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
    <div class="hero-text">
      <h1 class="serif" data-collection data-first-cycle="{{ site.collection.firstCycle }}" data-months="{{ site.collection.months }}">{{ site.collection.note }}</h1>
      <p>Cada peça tem um exemplar só. Quando é vendida, não volta.</p>
      <a class="btn btn-primary" href="#pecas">Ver as peças</a>
    </div>
  </section>

  {% include "partials/category-circles.njk" %}

  {#- Looks like a search field; opens the same search panel as the header magnifier #}
  <div class="search-shortcut-wrap">
    <button class="search-shortcut" type="button" data-search-open>{{ icon("search") }} <span>Buscar peças</span></button>
  </div>

  {#- One row per category with a few available pieces; the full list is on the category page #}
  <div class="showcase" id="pecas">
    {%- for c in categories %}
    {%- set pieces = products | showcase(c.slug) %}
    {%- set total = products | byCategory(c.slug) | length %}
    {%- if pieces | length %}
    <section class="showcase-row" aria-labelledby="row-{{ c.slug }}">
      <div class="container showcase-head">
        <h2 class="section-title serif" id="row-{{ c.slug }}">{{ c.label }}</h2>
        <a class="showcase-all" href="/{{ c.slug }}/">Ver todos ({{ total }})</a>
      </div>
      <div class="showcase-track">
        {%- for product in pieces %}
        {{ productCard(product, site.name, true) }}
        {%- endfor %}
      </div>
    </section>
    {%- endif %}
    {%- endfor %}
  </div>

  <section class="container section-tight" aria-label="Garantias">
    {% include "partials/guarantees.njk" %}
  </section>

  <section class="container home-section how-to-buy" id="como-comprar" aria-labelledby="como-comprar-title">
    <h2 class="section-title serif" id="como-comprar-title">Como comprar</h2>
    <ol class="steps">
      {%- for step in howToBuy %}
      <li class="step">
        <span class="step-number serif">{{ loop.index }}</span>
        <div>
          <h3>{{ step.title }}</h3>
          <p>{{ step.text }}</p>
        </div>
      </li>
      {%- endfor %}
    </ol>
    <div class="policies">
      <details class="policy">
        <summary>Formas de pagamento</summary>
        <ul>
          {%- for method in storePolicies.paymentMethods %}
          <li>{{ method }}</li>
          {%- endfor %}
        </ul>
        <p class="policy-label">Parcelamento sem juros no cartão de crédito</p>
        <ul>
          {%- for rule in storePolicies.installments %}
          <li>Compras acima de {{ rule.above | brl }}: em até <strong>{{ rule.count }}x sem juros</strong></li>
          {%- endfor %}
        </ul>
      </details>
      <details class="policy">
        <summary>Entrega</summary>
        <ul>
          {%- for line in storePolicies.delivery %}
          <li>{{ line }}</li>
          {%- endfor %}
        </ul>
      </details>
      <details class="policy">
        <summary>Garantia</summary>
        <p><strong>{{ storePolicies.warranty.summary }}</strong></p>
        <p class="policy-label">O que a garantia cobre</p>
        <ul>
          {%- for item in storePolicies.warranty.covers %}<li>{{ item }}</li>{% endfor %}
        </ul>
        <p class="policy-label">O que a garantia não cobre</p>
        <ul>
          {%- for item in storePolicies.warranty.doesNotCover %}<li>{{ item }}</li>{% endfor %}
        </ul>
        <p class="policy-label">Como solicitar</p>
        <p>{{ storePolicies.warranty.howToClaim }}</p>
      </details>
    </div>

    <div class="how-to-buy-actions">
      <button class="btn btn-secondary" type="button" data-list-open>{{ icon("heart") }} Ver minha lista</button>
      <a class="btn btn-primary" href="{{ '' | directLink }}" target="_blank" rel="noopener">{{ icon("instagram") }} Falar no Direct</a>
    </div>
  </section>

  <p class="tagline-line serif">"{{ site.tagline }}"</p>
