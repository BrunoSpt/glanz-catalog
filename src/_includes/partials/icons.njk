{#- Inline SVG icons (stroke-based, inherit currentColor) -#}
{%- macro icon(name, className = "icon") -%}
<svg class="{{ className }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if name == "heart" -%}
<path d="M12 20s-7-4.4-9.2-9A5 5 0 0 1 12 6a5 5 0 0 1 9.2 5c-2.2 4.6-9.2 9-9.2 9z"/>
{%- elif name == "layers" -%}
<path d="M12 3 3 7.5 12 12l9-4.5L12 3z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/>
{%- elif name == "gem" -%}
<path d="M6 3h12l3 6-9 12L3 9l3-6z"/><path d="M3 9h18"/><path d="m9 3-1.5 6L12 21l4.5-12L15 3"/>
{%- elif name == "shield" -%}
<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.2 7.5 9.5 4.3-1.3 7.5-4.9 7.5-9.5V6L12 3z"/><path d="m8.8 12 2.2 2.2 4.3-4.4"/>
{%- elif name == "share" -%}
<path d="M12 3v12"/><path d="m7.5 7.5 4.5-4.5 4.5 4.5"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/>
{%- elif name == "zoom" -%}
<circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.8-4.8"/><path d="M10.5 7.5v6M7.5 10.5h6"/>
{%- elif name == "close" -%}
<path d="M6 6l12 12M18 6 6 18"/>
{%- elif name == "chevron-left" -%}
<path d="m15 5-7 7 7 7"/>
{%- elif name == "chevron-right" -%}
<path d="m9 5 7 7-7 7"/>
{%- elif name == "copy" -%}
<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>
{%- elif name == "check" -%}
<path d="m5 12.5 4.5 4.5L19 7.5"/>
{%- elif name == "plus" -%}
<path d="M12 5v14M5 12h14"/>
{%- elif name == "minus" -%}
<path d="M5 12h14"/>
{%- elif name == "instagram" -%}
<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="1"/>
{%- endif -%}
</svg>
{%- endmacro %}
