{%- from "partials/icons.njk" import icon -%}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#FFFBF6">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32.png">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
<!-- iPhone: short name on the home screen; don't turn numbers (prices) into phone links -->
<meta name="apple-mobile-web-app-title" content="GLANZ">
<meta name="format-detection" content="telephone=no">
<!-- link preview when shared (Instagram, WhatsApp, etc.) -->
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ page.url | absoluteUrl }}">
<meta property="og:image" content="{{ (ogImage or site.ogImage.path) | absoluteUrl }}">
{%- if not ogImage %}
<meta property="og:image:width" content="{{ site.ogImage.width }}">
<meta property="og:image:height" content="{{ site.ogImage.height }}">
<meta property="og:image:alt" content="{{ site.ogImage.alt }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href="{{ page.url | absoluteUrl }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Jost:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
<script>document.documentElement.classList.add('js')</script>
</head>
<body data-instagram="{{ site.instagram }}" data-list-message="{{ site.listMessage }}" data-placeholder-image="{{ '/assets/brand/sunburst.png' | withBase }}" data-installments="{{ storePolicies.installments | dump }}">

<header class="site-header">
  <div class="bar">
    <a class="brandmark" href="/">
      <img class="mark-icon" src="/assets/brand/sunburst.png" width="160" height="165" alt="">
      <span class="word">GLANZ</span>
    </a>
    <div class="header-actions">
      {%- if headerLink == "instagram" %}
      <a class="back-link" href="{{ '' | directLink }}" target="_blank" rel="noopener">Instagram →</a>
      {%- else %}
      <a class="back-link" href="/">← Catálogo</a>
      {%- endif %}
      <button class="list-button" type="button" data-list-open aria-label="Abrir lista de interesse">
        {{ icon("heart") }}<span class="list-count" data-list-count hidden>0</span>
      </button>
    </div>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <img class="mark" src="/assets/brand/glanz-mark.webp" width="607" height="450" alt="{{ site.name }}">
  <p>@{{ site.instagram }} · {{ site.city }}</p>
  <p><a href="/#como-comprar">Como comprar</a></p>
</footer>

<a class="ig-float" href="{{ '' | directLink }}" target="_blank" rel="noopener" aria-label="Falar no Instagram Direct">
  {{ icon("instagram") }}
</a>

{#- Interest list: filled by js/interest-list.js from localStorage #}
<dialog class="drawer" id="interestList" aria-labelledby="interestListTitle">
  <div class="drawer-panel" tabindex="-1" autofocus>
    <div class="drawer-head">
      <h2 class="serif" id="interestListTitle">Sua lista de interesse</h2>
      <button class="icon-button" type="button" data-list-close aria-label="Fechar">{{ icon("close") }}</button>
    </div>
    <p class="drawer-notice" data-list-notice hidden></p>
    <ul class="drawer-items" data-list-items></ul>
    <p class="drawer-empty" data-list-empty>Sua lista está vazia. Toque no {{ icon("heart", "icon icon-inline") }} das peças que você gostou.</p>
    <div class="drawer-foot" data-list-foot hidden>
      <p class="drawer-total"><span>Total</span> <strong data-list-total></strong> <span class="drawer-installments" data-list-installments></span></p>
      {#- Two explicit steps: copying while Instagram opens is unreliable on phones #}
      <label class="drawer-label" for="listMessage">Mensagem para enviar</label>
      <textarea class="list-message" id="listMessage" rows="4" readonly data-list-message-box></textarea>
      <button class="btn btn-secondary" type="button" data-list-copy>
        <span class="step-badge">1</span>{{ icon("copy") }}<span data-list-copy-label>Copiar lista</span>
      </button>
      <a class="btn btn-primary" data-list-send href="{{ '' | directLink }}" target="_blank" rel="noopener">
        <span class="step-badge">2</span>{{ icon("instagram") }} Abrir o Direct e colar
      </a>
      <p class="drawer-note">Se a cópia não funcionar, segure o dedo no texto acima para copiar.<br>A lista fica salva só neste aparelho.</p>
    </div>
  </div>
</dialog>

{#- Pieces currently available (sold ones and past collections are left out); read by js/interest-list.js #}
<script type="application/json" id="catalogIndex">{{ products | catalogIndex | safe }}</script>
<script type="module" src="/js/main.js"></script>
</body>
</html>
